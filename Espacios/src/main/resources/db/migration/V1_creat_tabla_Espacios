DROP TABLE IF EXISTS Espacio;
DROP TABLE IF EXISTS Espacios;
DROP TABLE IF EXISTS User;

CREATE TABLE Espacio (
    espacio_id INT AUTO_INCREMENT PRIMARY KEY,
    espacio_nombre VARCHAR(40) NOT NULL,
    espacio_tipo VARCHAR(30) NOT NULL,
    espacio_capacidad INTEGER(3) NOT NULL
);

CREATE TABLE Espacios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    espacio_id INT,
    residencia_id INT
);

CREATE TABLE User (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    user_nombre VARCHAR(40) NOT NULL,
    user_apellido VARCHAR(50) NOT NULL,
    user_rut VARCHAR(11) NOT NULL,
    user_email VARCHAR(45),
    user_telefono INT(13)
);

